<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetCoreTargetVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>DotNet Rene Utils Db - Mapster</Title>
    <Description>Mapster integration for Rene.Utils.Db. Use options.UseMapster() in AddDbUtils to map view models with Mapster.</Description>
    <PackageProjectUrl>https://github.com/renepacios/DotNet.Rene.Utils.Db</PackageProjectUrl>
    <RepositoryUrl>https://github.com/renepacios/DotNet.Rene.Utils.Db</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rene.Utils.Db\Rene.Utils.Db.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mapster" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
