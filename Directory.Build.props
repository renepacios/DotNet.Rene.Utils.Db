<Project>
  <PropertyGroup Label="SDK Versions">
    <NetStandardTargetVersion>netstandard2.1</NetStandardTargetVersion>
    <NetCoreTargetVersion>net10.0</NetCoreTargetVersion>
  </PropertyGroup>
  <PropertyGroup>
    <VersionPrefix>2</VersionPrefix>
    <Version>$(VersionPrefix).0.0.0</Version>

    <FileVersion>$(Version)</FileVersion>
    <Authors>René Pacios</Authors>
    <Company>WebRene.es</Company>
    <Copyright>Copyright © $(Company) - $([System.DateTime]::Now.Year)</Copyright>
    <ProjectUrl></ProjectUrl>
    <Repository></Repository>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
    <WarningsAsErrors></WarningsAsErrors>
    <Nullable>disable</Nullable>
  </PropertyGroup>


</Project>